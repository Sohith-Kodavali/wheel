# Orders are stored in Supabase when these two are set.
# Leave them blank (or remove this file) to use the local SQLite file at data/orders.db.
SUPABASE_URL=
# New secret key from Project Settings → API Keys (starts with sb_secret_).
# Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=

# Optional
PORT=5173
# Signs the admin session cookie. Falls back to SUPABASE_SECRET_KEY.
# Set a long random value on Vercel so sessions survive key changes.
# ADMIN_SESSION_SECRET=
# Set to 1 when the site is served over HTTPS (Vercel sets this automatically).
# COOKIE_SECURE=1
